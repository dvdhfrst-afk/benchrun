  "plan_source": "{\n  \"name\": \"regulator-quick\",\n  \"version\": \"1.0\",\n  \"description\": \"Short functional check that only needs a supply and a multimeter.\",\n  \"vars\": { \"vnom\": 5.0 },\n  \"instruments\": {\n    \"supply\": { \"driver\": \"psu\", \"address\": \"127.0.0.1:5026\" },\n    \"dmm\": { \"driver\": \"dmm\", \"address\": \"127.0.0.1:5025\" }\n  },\n  \"setup\": [\n    { \"do\": \"supply.set_current_limit\", \"amps\": 0.5 },\n    { \"do\": \"supply.set_voltage\", \"volts\": 12.0 },\n    { \"do\": \"supply.output_on\" }\n  ],\n  \"steps\": [\n    {\n      \"name\": \"output_voltage\",\n      \"sweep\": { \"var\": \"vin\", \"values\": [8.0, 12.0, 16.0] },\n      \"apply\": [{ \"do\": \"supply.set_voltage\", \"volts\": \"=vin\" }],\n      \"settle_s\": 0.01,\n      \"measure\": [\n        { \"name\": \"vout\", \"read\": \"dmm.measure_dc_voltage\", \"units\": \"V\", \"low\": \"=vnom * 0.98\", \"high\": \"=vnom * 1.02\" }\n      ]\n    }\n  ],\n  \"teardown\": [{ \"do\": \"supply.output_off\" }]\n}\n",
